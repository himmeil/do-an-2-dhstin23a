rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validPlace(data) {
      return data.keys().hasAll([
          'name', 'category', 'address', 'lat', 'lng', 'phone', 'hours'
        ])
        && data.keys().hasOnly([
          'name', 'category', 'address', 'lat', 'lng', 'phone', 'hours'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.category in [
          'quan_an', 'cafe', 'truong_hoc', 'tro', 'ben_xe',
          'vui_choi', 'mua_sam', 'khac'
        ]
        && data.address is string
        && data.address.size() <= 500
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.phone is string
        && data.phone.size() <= 40
        && data.hours is string
        && data.hours.size() <= 200;
    }

    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlace(request.resource.data);
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
            'userId', 'accountName', 'content', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'userId', 'accountName', 'content', 'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.auth.token.email is string
          && request.resource.data.accountName == request.auth.token.email
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/favorites/{placeId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['placeId', 'savedAt'])
        && request.resource.data.placeId == placeId
        && request.resource.data.savedAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /admin_error_codes/{code} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && code in [
          'OSM_SNAPSHOT_READ_FAILED',
          'NEARBY_SEARCH_FAILED',
          'PLACES_READ_FAILED',
          'COMMENTS_READ_FAILED',
          'COMMENT_WRITE_FAILED',
          'FAVORITES_READ_FAILED',
          'LOCATION_LOOKUP_FAILED',
          'FAVORITE_WRITE_FAILED',
          'DRAFT_READ_FAILED',
          'DRAFT_PUBLISH_FAILED',
          'DISPLAY_SETTINGS_READ_FAILED',
          'DISPLAY_SETTINGS_WRITE_FAILED',
          'SIGN_OUT_FAILED',
          'MAP_REFRESH_FAILED',
          'MAP_SOURCE_READ_FAILED',
          'MAP_SOURCE_APPLY_FAILED'
        ]
        && request.resource.data.keys().hasAll(['code', 'lastSeenAt'])
        && request.resource.data.keys().hasOnly(['code', 'lastSeenAt'])
        && request.resource.data.code == code
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
