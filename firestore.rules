rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validPlace(data) {
      return data.keys().hasAll([
          'name', 'category', 'address', 'lat', 'lng', 'phone', 'hours'
        ])
        && data.keys().hasOnly([
          'name', 'category', 'address', 'lat', 'lng', 'phone', 'hours'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 150
        && data.category in [
          'quan_an', 'cafe', 'tro', 'vui_choi', 'mua_sam', 'khac'
        ]
        && data.address is string
        && data.address.size() <= 500
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.phone is string
        && data.phone.size() <= 40
        && data.hours is string
        && data.hours.size() <= 200;
    }

    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlace(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId}/favorites/{placeId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['placeId', 'savedAt'])
        && request.resource.data.placeId == placeId
        && request.resource.data.savedAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
